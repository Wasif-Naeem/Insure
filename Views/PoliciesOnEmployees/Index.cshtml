@model IEnumerable<Health_Insurance.Models.PoliciesOnEmployees>
@{
    ViewData["Title"] = "Policies On Employees";
    Layout = "_AdminLayout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">Policies Assigned to Employees</h2>
        <a asp-action="Create" class="btn btn-success"><i class="fas fa-plus me-2"></i>Assign New Policy</a>
    </div>

    <table class="table table-hover table-bordered align-middle text-center">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Employee</th>
                <th>Policy</th>
                <th>Company</th>
                <th>Amount</th>
                <th>EMI</th>
                <th>Start</th>
                <th>End</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @{
                int i = 1;
                foreach (var item in Model)
                {
                    <tr>
                        <td>@i</td>
                        <td>@item.Employee?.FirstName @item.Employee?.LastName</td>
                        <td>@item.PolicyName</td>
                        <td>@item.CompanyName</td>
                        <td>@item.PolicyAmount?.ToString("N0") PKR</td>
                        <td>@item.Emi?.ToString("N0")</td>
                        <td>@item.PStartDate?.ToShortDateString()</td>
                        <td>@item.PEndDate?.ToShortDateString()</td>
                        <td>
                            <span class="badge bg-@(item.Status == "Active" ? "success" : "secondary")">@item.Status</span>
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="text-info me-2"><i class="fas fa-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="text-warning me-2"><i class="fas fa-edit"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                    i++;
                }
            }
        </tbody>
    </table>
</div>
