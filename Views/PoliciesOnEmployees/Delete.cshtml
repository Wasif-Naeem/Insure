@model Health_Insurance.Models.PoliciesOnEmployees
@{
    ViewData["Title"] = "Delete Assigned Policy";
    Layout = "_AdminLayout";
}

<div class="container mt-4" style="max-width:600px;">
    <h3 class="text-danger text-center mb-3">Are you sure you want to delete this record?</h3>

    <dl class="row">
        <dt class="col-sm-4">Employee:</dt>
        <dd class="col-sm-8">@Model.Employee?.FirstName @Model.Employee?.LastName</dd>
        <dt class="col-sm-4">Policy:</dt>
        <dd class="col-sm-8">@Model.PolicyName</dd>
        <dt class="col-sm-4">Company:</dt>
        <dd class="col-sm-8">@Model.CompanyName</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
            <button type="submit" class="btn btn-danger px-4">Delete</button>
        </div>
    </form>
</div>
