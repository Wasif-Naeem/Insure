@model Health_Insurance.Models.HospitalInfo
@{
    ViewData["Title"] = "Delete Hospital";
    Layout = "_AdminLayout";
}

<div class="container mt-4" style="max-width:600px;">
    <h2 class="text-center text-danger mb-4">@ViewData["Title"]</h2>

    <div class="alert alert-warning text-center">
        <strong>Are you sure you want to delete this hospital?</strong>
    </div>

    <dl class="row mb-4">
        <dt class="col-sm-4">Name:</dt>
        <dd class="col-sm-8">@Model.HospitalName</dd>

        <dt class="col-sm-4">Phone:</dt>
        <dd class="col-sm-8">@Model.PhoneNo</dd>

        <dt class="col-sm-4">Location:</dt>
        <dd class="col-sm-8">@Model.Location</dd>

        <dt class="col-sm-4">URL:</dt>
        <dd class="col-sm-8">
            @if (!string.IsNullOrEmpty(Model.Url))
            {
                <a href="@Model.Url" target="_blank">@Model.Url</a>
            }
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="HospitalId" />
        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
            <button type="submit" class="btn btn-danger px-4">Delete</button>
        </div>
    </form>
</div>
