@model Health_Insurance.Models.HospitalInfo
@{
    ViewData["Title"] = "Hospital Details";
    Layout = "_AdminLayout";
}

<div class="container mt-4" style="max-width:700px;">
    <h2 class="text-center mb-4">@ViewData["Title"]</h2>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h4 class="text-primary mb-3">@Model.HospitalName</h4>

            <p><strong>Phone:</strong> @Model.PhoneNo</p>
            <p><strong>Location:</strong> @Model.Location</p>
            <p>
                <strong>Website:</strong>
                @if (!string.IsNullOrEmpty(Model.Url))
                {
                    <a href="@Model.Url" target="_blank">@Model.Url</a>
                }
                else
                {
                    <span class="text-muted">N/A</span>
                }
            </p>

            <div class="mt-4 d-flex justify-content-between">
                <a asp-action="Edit" asp-route-id="@Model.HospitalId" class="btn logout-btn px-4">Edit</a>
                <a asp-action="Index" class="btn btn-secondary px-4">Back</a>
            </div>
        </div>
    </div>
</div>
