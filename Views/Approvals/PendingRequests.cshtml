@model IEnumerable<Health_Insurance.Models.PolicyRequestDetails>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Pending Policy Requests";
}

<h3 class="fw-bold text-primary mb-3">🕓 Pending Policy Requests</h3>

<table class="table table-hover table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th>Employee</th>
            <th>Policy</th>
            <th>Company</th>
            <th>Request Date</th>
            <th>Status</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Employee?.FirstName @r.Employee?.LastName</td>
                <td>@r.Policy?.PolicyName</td>
                <td>@r.Policy?.Company?.CompanyName</td>
                <td>@r.RequestDate?.ToShortDateString()</td>
                <td><span class="badge bg-warning text-dark">@r.Status</span></td>
                <td class="text-center">
                    <a asp-action="Approve" asp-route-id="@r.RequestId" class="btn btn-sm btn-success me-2"><i class="fas fa-check"></i></a>
                    <form asp-action="Reject" asp-route-id="@r.RequestId" method="post" class="d-inline">
                        <input type="hidden" name="adminRemarks" value="Rejected by admin" />
                        <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-times"></i></button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
