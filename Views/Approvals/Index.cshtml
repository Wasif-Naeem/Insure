@model IEnumerable<Health_Insurance.Models.PolicyApprovalDetails>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Policy Approvals";
}
<h3 class="fw-bold text-primary mb-3">✅ Policy Approvals</h3>
<a asp-action="Create" class="btn btn-primary mb-3">+ Add Approval</a>

<table class="table table-hover table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th>Policy</th>
            <th>Request</th>
            <th>Amount</th>
            <th>Status</th>
            <th>Date</th>
            <th>Reason</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.Policy?.PolicyName</td>
                <td>@a.Request?.PolicyName</td>
                <td>@a.Amount</td>
                <td>@a.Status</td>
                <td>@a.Date?.ToShortDateString()</td>
                <td>@a.Reason</td>
                <td class="text-center">
                    <a asp-action="Edit" asp-route-id="@a.Id" class="text-warning me-3"><i class="fas fa-edit fa-lg"></i></a>
                    <a asp-action="Delete" asp-route-id="@a.Id" class="text-danger"><i class="fas fa-trash-alt fa-lg"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>
