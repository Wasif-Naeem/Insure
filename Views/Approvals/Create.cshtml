@model Health_Insurance.Models.PolicyApprovalDetails
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Add Approval";
}

<h3 class="fw-bold text-primary mb-3">Add New Approval</h3>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="PolicyId" class="form-label">Select Policy</label>
        <select asp-for="PolicyId" asp-items="ViewBag.PolicyList" class="form-select">
            <option value="">-- Select Policy --</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="RequestId" class="form-label">Select Request</label>
        <select asp-for="RequestId" asp-items="ViewBag.RequestList" class="form-select">
            <option value="">-- Select Request --</option>
        </select>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Amount" class="form-label"></label>
            <input asp-for="Amount" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select">
                <option>Pending</option>
                <option>Approved</option>
                <option>Rejected</option>
            </select>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Date" class="form-label"></label>
            <input asp-for="Date" class="form-control" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Reason" class="form-label"></label>
        <textarea asp-for="Reason" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
