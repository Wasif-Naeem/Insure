@model Health_Insurance.Models.EmpRegister
@{
    Layout = "_EmployeeLayout";

    ViewData["Title"] = "Edit Profile";
}

<div class="container mt-4">
    <h3>Edit Profile</h3>
    <hr />
    <form method="post">
        <input type="hidden" asp-for="EmpNo" />
        <div class="row">
            <div class="col-md-6">
                <label asp-for="FirstName"></label>
                <input asp-for="FirstName" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="LastName"></label>
                <input asp-for="LastName" class="form-control" />
            </div>
        </div>

        <div class="mt-3">
            <label asp-for="Designation"></label>
            <input asp-for="Designation" class="form-control" />
        </div>

        <div class="mt-3">
            <label asp-for="Address"></label>
            <input asp-for="Address" class="form-control" />
        </div>

        <div class="mt-3">
            <label asp-for="ContactNo"></label>
            <input asp-for="ContactNo" class="form-control" />
        </div>

        <div class="row mt-3">
            <div class="col-md-4">
                <label asp-for="State"></label>
                <input asp-for="State" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="City"></label>
                <input asp-for="City" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="Country"></label>
                <input asp-for="Country" class="form-control" />
            </div>
        </div>

        <button class="btn logout-btn mt-3">Save Changes</button>
    </form>
</div>
