@{
    Layout = "_EmployeeLayout";

    ViewData["Title"] = "Search Policies";
}

<div class="container mt-4">
    <h3>Search Policies</h3>
    <form method="post" class="d-flex mb-3">
        <input type="text" name="keyword" class="form-control me-2" placeholder="Enter keyword..." />
        <button class="btn btn-primary">Search</button>
    </form>

    @if (ViewBag.RequestMsg != null)
    {
        <div class="alert alert-success">@ViewBag.RequestMsg</div>
    }
</div>
