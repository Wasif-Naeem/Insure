@model IEnumerable<Health_Insurance.Models.PolicyRequestDetails>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Admin Dashboard";
}

<div class="dashboard-container">
    <!-- Hero Section -->
    <div class="hero-section">
        <div class="hero-content">
            <h1 class="hero-title">
                <span class="gradient-text">Admin Dashboard</span>
            </h1>
            <p class="hero-subtitle">Manage your insurance platform efficiently</p>
        </div>
        <div class="hero-decoration"></div>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid">
        <div class="stat-card stat-card-1">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                </svg>
            </div>
            <div class="stat-content">
                <div class="stat-value">@ViewBag.CompanyCount</div>
                <div class="stat-label">Insurance Companies</div>
            </div>
        </div>

        <div class="stat-card stat-card-2">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
            </div>
            <div class="stat-content">
                <div class="stat-value">@ViewBag.PolicyCount</div>
                <div class="stat-label">Total Policies</div>
            </div>
        </div>

        <div class="stat-card stat-card-3">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 00-3-3.87" />
                    <path d="M16 3.13a4 4 0 010 7.75" />
                </svg>
            </div>
            <div class="stat-content">
                <div class="stat-value">@ViewBag.EmployeeCount</div>
                <div class="stat-label">Registered Employees</div>
            </div>
        </div>

        <div class="stat-card stat-card-4">
            <div class="stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M12 6v6l4 2" />
                </svg>
            </div>
            <div class="stat-content">
                <div class="stat-value">@ViewBag.PendingRequests</div>
                <div class="stat-label">Pending Requests</div>
            </div>
        </div>
    </div>

    <!-- ✅ Recent Pending Policy Requests Panel -->
    <div class="recent-panel mt-4">
        <div class="panel-header">
            <h2 class="panel-title">🕓 Pending Policy Requests</h2>
            <div class="panel-decoration"></div>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-light border-0 rounded-3 text-center text-muted">
                No pending requests at the moment.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle ">
                    <thead class="table-light">
                        <tr>
                            <th>Employee</th>
                            <th>Policy Name</th>
                            <th>Amount</th>
                            <th>EMI</th>
                            <th>Request Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in Model)
                        {
                            <tr>
                                <td>@req.Employee?.FirstName @req.Employee?.LastName</td>
                                <td>@(req.PolicyName ?? req.Policy?.PolicyName ?? "N/A")</td>
                                <td>@(req.PolicyAmount?.ToString("N0")) PKR</td>
                                <td>@(req.Emi?.ToString("N0")) / Month</td>
                                <td>@req.RequestDate?.ToString("dd-MMM-yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const statCards = document.querySelectorAll('.stat-card');
            statCards.forEach((card, index) => {
                card.style.animationDelay = `${index * 0.1}s`;
            });
        });
    </script>
}
