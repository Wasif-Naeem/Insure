@model IEnumerable<Health_Insurance.Models.EmpRegister>
@{
    ViewData["Title"] = "Employees";
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">All Employees (@ViewBag.TotalEmployees)</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i> Add Employee
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="table-responsive shadow-sm rounded-3">
        <table class="table table-bordered table-hover align-middle text-center small" style="font-size:13px; width:100%;">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Email</th>
                    <th>Designation</th>
                    <th>Contact</th>
                    <th style="min-width:120px;">Address</th>
                    <th>City</th>
                    <th>State</th>
                    <th>Country</th>
                    <th>Salary</th>
                    <th style="width:90px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="12" class="text-center text-muted py-4">No employees found.</td>
                    </tr>
                }
                else
                {
                    int count = 1;
                    foreach (var emp in Model)
                    {
                        <tr>
                            <td>@count</td>
                            <td>@emp.FirstName</td>
                            <td>@emp.LastName</td>
                            <td>@emp.Username</td>
                            <td>@emp.Designation</td>
                            <td>@emp.ContactNo</td>
                            <td class="text-truncate" style="max-width:150px;" title="@emp.Address">@emp.Address</td>
                            <td>@emp.City</td>
                            <td>@emp.State</td>
                            <td>@emp.Country</td>
                            <td>@emp.Salary?.ToString("N0")</td>
                            <td class="text-nowrap">
                                <div class="d-flex justify-content-center align-items-center gap-2">
                                    <a asp-action="Details" asp-route-id="@emp.EmpNo" class="text-info" title="View">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@emp.EmpNo" class="text-warning" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@emp.EmpNo" class="text-danger" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        count++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    table.table {
        border-color: #e3e6f0 !important;
    }

        table.table th, table.table td {
            vertical-align: middle !important;
            padding: 8px 10px;
            white-space: nowrap;
        }

            table.table td.text-truncate {
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

        table.table tbody tr:hover {
            background-color: #f8f9fa;
            transition: background-color 0.2s ease-in-out;
        }

    .table .fa-eye, .table .fa-edit, .table .fa-trash {
        font-size: 16px;
        transition: transform 0.2s ease, color 0.2s ease;
    }

        .table .fa-eye:hover {
            color: #0d6efd;
            transform: scale(1.15);
        }

        .table .fa-edit:hover {
            color: #ffc107;
            transform: scale(1.15);
        }

        .table .fa-trash:hover {
            color: #dc3545;
            transform: scale(1.15);
        }
</style>
