@model Health_Insurance.Models.EmpRegister
@{
    ViewData["Title"] = "Delete Employee";
    Layout = "_AdminLayout";
}

<div class="container mt-4" style="max-width:600px;">
    <h2 class="text-center text-danger mb-4">@ViewData["Title"]</h2>

    <div class="alert alert-warning text-center">
        <strong>Are you sure you want to delete this employee?</strong>
    </div>

    <dl class="row mb-4">
        <dt class="col-sm-4">Full Name:</dt>
        <dd class="col-sm-8">@Model.FirstName @Model.LastName</dd>

        <dt class="col-sm-4">Email:</dt>
        <dd class="col-sm-8">@Model.Username</dd>

        <dt class="col-sm-4">Designation:</dt>
        <dd class="col-sm-8">@Model.Designation</dd>

        <dt class="col-sm-4">Contact:</dt>
        <dd class="col-sm-8">@Model.ContactNo</dd>

        <dt class="col-sm-4">City:</dt>
        <dd class="col-sm-8">@Model.City</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="EmpNo" />
        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
            <button type="submit" class="btn btn-danger px-4">Delete</button>
        </div>
    </form>
</div>
