@model Health_Insurance.Models.CompanyDetails
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Company";
}
<h3 class="fw-bold text-primary mb-3">Edit Company</h3>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="CompanyId" />
    <div class="mb-3">
        <label asp-for="CompanyName" class="form-label"></label>
        <input asp-for="CompanyName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="CompanyUrl" class="form-label"></label>
        <input asp-for="CompanyUrl" class="form-control" type="url" />
    </div>
    <button type="submit" class="btn logout-btn">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
