@page
@model LoginModel
@{
    ViewData["Title"] = "Employee Login";
}

<div class="container mt-5" style="max-width:600px;">
    <h2 class="text-center mb-4">@ViewData["Title"]</h2>

    <form id="account" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <!-- Email -->
        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label fw-semibold">Email</label>
            <input asp-for="Input.Email" class="form-control" placeholder="Enter your email" autocomplete="username" aria-required="true" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <!-- Password -->
        <div class="mb-3">
            <label asp-for="Input.Password" class="form-label fw-semibold">Password</label>
            <input asp-for="Input.Password" class="form-control" placeholder="Enter your password" autocomplete="current-password" aria-required="true" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <!-- Remember Me -->
        <div class="form-check mb-3">
            <input class="form-check-input" asp-for="Input.RememberMe" />
            <label class="form-check-label text-muted" asp-for="Input.RememberMe">
                Remember me
            </label>
        </div>

        <!-- Submit -->
        <button id="login-submit" type="submit" class="btn btn-primary w-100 mt-3">
            <i class="fas fa-sign-in-alt me-2"></i> Login
        </button>

        <!-- Links -->
        <div class="text-center mt-4">
            <a id="forgot-password" class="text-decoration-none text-black me-3">Don’t have an account?<</a>
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none">Create account</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
